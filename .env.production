# TrackOja production build config.
# Production database: wgcolmnlieefqvtzfvjt (decided 31 Oct 2026; it holds the
# real users, and the paused xegcukmbinkyffzmfejc project is retired). The anon /
# publishable key is public by design. On Vercel, environment variables of the
# same name override these values.
VITE_SUPABASE_URL=https://wgcolmnlieefqvtzfvjt.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_eBU7X24HHN4AMmMMpLR21w_vVwhQL8T
VITE_APP_NAME=TrackOja
# Declares which environment this build targets, so the Platform Owner console
# can label it. Environment is a property of the deployment, not the database,
# and this database is shared with local development - so it has to be declared
# per build. Override per Vercel environment to make a preview say "staging".
VITE_ENVIRONMENT=production
